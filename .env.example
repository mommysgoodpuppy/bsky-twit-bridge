# Bluesky Credentials
# Use an app password from https://bsky.app/settings/app-passwords
BSKY_USERNAME=your-username.bsky.social
BSKY_PASSWORD=your-app-password

# Twitter User to Monitor
TWITTER_USER=TwitterUsername

# Twitter session cookies, taken from a logged-in browser session
TWITTER_CT0=your-ct0-cookie
TWITTER_AUTH_TOKEN=your-auth_token-cookie

# Cron schedule for the mirror (standard 5-field cron, UTC)
CRON_SCHEDULE=*/5 * * * *

# On the first run only, mirror tweets from this many days back.
# Backfilled posts keep their original tweet timestamps.
# 0 = don't backfill, only mirror tweets posted from now on.
BACKFILL_DAYS=30

# Tweets fetched per poll, and per first-run backfill (needs to cover
# BACKFILL_DAYS worth of tweets).
FETCH_COUNT=20
BACKFILL_FETCH_COUNT=100

# Most posts to publish in a single run. A backfill longer than this resumes on
# the next cron tick rather than running past the invocation's time budget.
MAX_POSTS_PER_RUN=10

# How long to wait for Bluesky to finish processing an uploaded video, and how
# many failed attempts before a tweet is mirrored without its video.
VIDEO_JOB_TIMEOUT_SECONDS=240
MAX_ATTEMPTS_WITH_VIDEO=2

# Set to enable POST /run for manually triggering a mirror pass.
# Leave unset and the endpoint 404s.
# RUN_TOKEN=some-long-random-string
